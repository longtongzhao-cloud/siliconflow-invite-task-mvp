[Unit]
Description=SiliconFlow invite task MVP
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=siliconflow-mvp
Group=siliconflow-mvp
WorkingDirectory=/opt/siliconflow-invite-task/current
EnvironmentFile=/etc/siliconflow-invite-task/mvp.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/usr/bin/test -r /etc/siliconflow-invite-task/mvp.env
ExecStart=/opt/siliconflow-invite-task/venv/bin/python -m uvicorn mvp_app.main:app --host 127.0.0.1 --port 8765 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=3s
TimeoutStopSec=30s
UMask=0077

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/siliconflow-invite-task
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
