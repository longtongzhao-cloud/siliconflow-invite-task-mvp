[Unit]
Description=Back up the SiliconFlow invite task SQLite database
After=siliconflow-invite-task.service

[Service]
Type=oneshot
User=siliconflow-mvp
Group=siliconflow-mvp
EnvironmentFile=/etc/siliconflow-invite-task/mvp.env
ExecStart=/opt/siliconflow-invite-task/venv/bin/python /opt/siliconflow-invite-task/current/deploy/backup_sqlite.py --database ${MVP_DB_PATH} --backup-dir /var/backups/siliconflow-invite-task --retention-days 7
UMask=0077

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/var/lib/siliconflow-invite-task
ReadWritePaths=/var/backups/siliconflow-invite-task
RestrictAddressFamilies=AF_UNIX
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
