MVP_ENV=production
MVP_HOST=127.0.0.1
MVP_PORT=8765
MVP_DB_PATH=/var/lib/siliconflow-invite-task/mvp.db
MVP_SECRET=replace-with-at-least-32-random-bytes
MVP_ADMIN_KEY=replace-with-at-least-16-random-characters
MVP_ALLOWED_HOSTS=example.com,127.0.0.1,localhost
MVP_COOKIE_SECURE=1
MVP_SILICON_MODE=manual
MVP_SITE_SMS_MODE=disabled
MVP_SITE_SMS_ALLOWED_PHONES=
MVP_SITE_SMS_MAX_SENDS_PER_HOUR=20
MVP_SITE_SMS_MAX_SENDS_PER_DAY=50
# Required only when MVP_SITE_SMS_MODE=aliyun-dypns
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
MVP_SITE_SMS_SIGN_NAME=
MVP_SITE_SMS_TEMPLATE_CODE=
MVP_SITE_SMS_SCHEME_NAME=mvp-login
MVP_REMOTE_BROWSER_MODE=disabled
MVP_SEED_DEMO=0
